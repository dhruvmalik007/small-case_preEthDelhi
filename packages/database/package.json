{
  "name": "@repo/database",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "analyze": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "build": "pnpm run generate",
    "prepare": "pnpm run generate",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "migrate": "prisma migrate dev --name init --schema=./prisma/schema.prisma",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "6.4.1",
    "@prisma/client": "6.4.1",
    "@t3-oss/env-nextjs": "^0.13.4",
    "server-only": "^0.0.1",
    "undici": "^7.10.0",
    "ws": "^8.18.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.14.2",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "prisma": "6.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
