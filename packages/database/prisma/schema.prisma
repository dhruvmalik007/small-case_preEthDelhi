// Prisma schema for smallcase_defi database ORM types
// Mirrors vercel/next-forge packages/database structure, adapted to this project's entities

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["schemaEngineDriverAdapters"]
  output          = "../generated/client"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============ Enums ============

enum StrategyCategory {
  LENDING
  LIQUID_STAKING
  DEX_LP
  PERPS_YIELD
  STABLE_SAVINGS
  RESTAKING
  CROSS_CHAIN_YIELD
  RWA
  POINTS_FARMING
  INDEX_BETA
}

enum RiskLevel {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum Volatility {
  LOW
  MEDIUM
  HIGH
}

enum Rebalancing {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Role {
  INVESTOR
  PM
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

// ============ Core Catalogs (from Data Engineering Pipeline) ============

model Protocol {
  id              Int       @id @default(autoincrement())
  llamaId         String?
  slug            String    @unique
  name            String
  symbol          String?
  category        String
  website         String?
  twitter         String?
  github          String?
  chains          Json?
  tvlUsd          Decimal?  @db.Decimal(18, 2)
  lastSeenTvlTs   DateTime?
  raw             Json?

  assets          AssetUniverse[]
}

model AssetUniverse {
  id            Int       @id @default(autoincrement())
  protocolSlug  String?
  protocol      Protocol? @relation(fields: [protocolSlug], references: [slug])
  chain         String?
  tokenAddress  String?
  tokenSymbol   String?
  tokenDecimals Int?
  meta          Json?
}

model YieldSnapshot {
  id          Int      @id @default(autoincrement())
  protocolSlug String
  poolId      String?
  chain       String?
  apy         Decimal? @db.Decimal(9, 4)
  apyBase     Decimal? @db.Decimal(9, 4)
  apyReward   Decimal? @db.Decimal(9, 4)
  tvlUsd      Decimal? @db.Decimal(18, 2)
  timestamp   DateTime?
}

// ============ Users & Access ============

model User {
  id           String     @id @default(uuid())
  walletAddress String    @unique
  displayName  String?
  email        String?    @unique
  role         Role       @default(INVESTOR)
  kycStatus    KycStatus?
  riskLevel    RiskLevel?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  managedStrategies Strategy[] @relation("ManagerStrategies")
  subscriptions     Subscription[] @relation("UserSubscriptions")
}

model Subscription {
  id          String    @id @default(uuid())
  investorId  String
  investor    User      @relation("UserSubscriptions", fields: [investorId], references: [id])
  strategyId  String
  strategy    Strategy  @relation(fields: [strategyId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([investorId, strategyId])
}

// ============ Strategies (from strategies.ts + Architecture) ============

model Strategy {
  id                   String            @id @default(uuid())
  slug                 String            @unique
  name                 String
  shortDescription     String?
  longDescription      String?
  category             StrategyCategory
  expectedApyMin       Decimal?          @db.Decimal(6, 2)
  expectedApyMax       Decimal?          @db.Decimal(6, 2)
  historicalApyOneYear Decimal?          @db.Decimal(6, 2)
  riskLevel            RiskLevel
  volatility           Volatility
  maxDrawdownPct       Decimal?          @db.Decimal(6, 2)
  rebalancing          Rebalancing
  minInvestmentUsd     Decimal?          @db.Decimal(12, 2)

  // Fees as percentages (from strategies.ts)
  managementFeePct     Decimal?          @db.Decimal(5, 2)
  performanceFeePct    Decimal?          @db.Decimal(5, 2)

  // Additional pricing knobs (from architecture doc; optional)
  feeFlatCents         Int?
  feeAuaBps            Int?
  entryLoadBps         Int?
  exitLoadBps          Int?

  // Arrays and tags
  chains               String[]
  protocols            String[]
  tags                 String[]

  // Governance & visibility
  visibility           Visibility        @default(PUBLIC)
  indexInitial         Decimal           @default(100.00) @db.Decimal(10, 2)
  state                String?
  thesis               String?

  // Manager
  managerId            String?
  manager              User?             @relation("ManagerStrategies", fields: [managerId], references: [id])

  // Relations
  targets              StrategyTarget[]
  holdings             StrategyHolding[]
  backtest             StrategyBacktest?
  benchmark            StrategyBenchmark?
  investorProfile      StrategyInvestorProfile?
  subscriptions        Subscription[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model StrategyTarget {
  strategyId       String
  strategy         Strategy @relation(fields: [strategyId], references: [id])
  protocolSlug     String
  chain            String
  targetWeightBps  Int

  @@id([strategyId, protocolSlug, chain])
}

model StrategyHolding {
  id           Int      @id @default(autoincrement())
  strategyId   String
  strategy     Strategy @relation(fields: [strategyId], references: [id])
  protocol     String
  asset        String
  weightBps    Int
}

model StrategyBacktest {
  strategyId           String   @id
  strategy             Strategy @relation(fields: [strategyId], references: [id])
  cumulativeReturn1Y   Decimal? @db.Decimal(7, 2)
  sharpe               Decimal? @db.Decimal(7, 2)
  bestMonthPct         Decimal? @db.Decimal(7, 2)
  worstMonthPct        Decimal? @db.Decimal(7, 2)
  monthlyReturns1Y     Decimal[] @db.Decimal(7, 2)
}

model StrategyBenchmark {
  strategyId       String   @id
  strategy         Strategy @relation(fields: [strategyId], references: [id])
  label            String
  monthlyReturns1Y Decimal[] @db.Decimal(7, 2)
}

model StrategyInvestorProfile {
  strategyId  String   @id
  strategy    Strategy @relation(fields: [strategyId], references: [id])
  name        String
  description String
}
