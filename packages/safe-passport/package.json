{
  "name": "@smallcase_defi/safe-passport",
  "version": "0.0.1",
  "private": false,
  "sideEffects": false,
  "license": "MIT",
  "description": "Safe Passport: ZK-based identity verification (age, OFAC, KYC jurisdiction, RIA) via Self Protocol V2 with contracts and TS SDK.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.js"
    },
    "./encoding": {
      "types": "./src/encoding.ts",
      "import": "./dist/encoding.mjs",
      "require": "./dist/encoding.js"
    },
    "./selfConfig": {
      "types": "./src/selfConfig.ts",
      "import": "./dist/selfConfig.mjs",
      "require": "./dist/selfConfig.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist",
    "forge:build": "forge build -C contracts",
    "forge:test": "forge test -C contracts -vvv",
    "e2e": "tsx e2e/e2e.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "tsup": "^8.0.2",
    "tsx": "^4.19.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@selfxyz/contracts": "latest",
    "@selfxyz/qrcode": "latest",
    "viem": "^2.37.8",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
